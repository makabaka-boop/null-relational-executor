{
  "name": "structured-query-service",
  "version": "1.0.0",
  "description": "A TypeScript/Node service that executes typed, structured query plans without parsing SQL.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/test/",
    "start": "npm run build && node dist/server.js"
  },
  "keywords": [
    "query-plan",
    "three-valued-logic",
    "relational-algebra"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.17.0",
    "typescript": "^5.6.0"
  }
}
